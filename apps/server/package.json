{
  "name": "@clinicvoice/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --conditions=@clinicvoice/source src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@clinicvoice/db": "workspace:*",
    "@clinicvoice/shared": "workspace:*",
    "@fastify/formbody": "^9.0.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.3",
    "fastify": "^5.12.5",
    "kysely": "^0.29.6",
    "pino": "^10.4.0",
    "twilio": "^6.1.2",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "pino-pretty": "^13.2.0"
  }
}
