# ---- Runtime ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Public HTTPS base URL that reaches this server (ngrok reserved domain locally).
PUBLIC_BASE_URL=https://example.ngrok-free.app
CLINIC_TIMEZONE=America/Toronto

# ---- Database ----
# App connects as a member of app_role (no UPDATE/DELETE on audit_log).
DATABASE_URL=postgres://clinicvoice_app:app_dev_password@localhost:5432/clinicvoice
# Migrations and seed run as the schema owner.
DATABASE_MIGRATION_URL=postgres://clinicvoice_owner:owner_dev_password@localhost:5432/clinicvoice

# ---- OpenAI ----
OPENAI_API_KEY=
# Live phone turns: small and fast. Reasoning tokens are dead air, so keep effort at none/minimal.
OPENAI_LIVE_MODEL=gpt-5.4-mini
OPENAI_LIVE_REASONING_EFFORT=none
# Post-call summaries, implant extraction, transcript grading.
OPENAI_OFFLINE_MODEL=gpt-5.5

# ---- Twilio ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Staff line for warm transfers. Leave empty to turn transfers into callback tasks.
STAFF_TRANSFER_NUMBER=
# "twilio" sends real prep SMS; "record" keeps them in memory (local development).
SMS_MODE=record

# ---- Security ----
# 32+ random bytes, hex. Keys the HMAC used to store caller numbers as hashes.
PHONE_HASH_KEY=
# Shared secret for the mock RIS API (header: x-ris-api-key).
RIS_API_KEY=
# 32+ random characters. Signs staff dashboard session cookies.
SESSION_SECRET=
# Max simultaneous calls; protects OpenAI spend during public testing.
MAX_CONCURRENT_CALLS=5
MAX_CALLS_PER_NUMBER_PER_HOUR=6
# Daily model-token ceiling (live turns + background jobs). New calls are declined above it.
DAILY_TOKEN_BUDGET=2000000
# Run the background job worker (post-call summaries, implant extraction) in the server process.
RUN_WORKER=true

# ---- Seed ----
# Password for the seeded demo staff accounts.
SEED_STAFF_PASSWORD=lakeshore-demo
